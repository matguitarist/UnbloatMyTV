<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AndroidTVDebloater.ViewModels"
        xmlns:v="using:AndroidTVDebloater.Views"
        xmlns:l="using:AndroidTVDebloater.Localization"
        x:Class="AndroidTVDebloater.Views.MainWindow"
        Title="UnbloatMyTV"
        Width="1140" Height="800" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="{DynamicResource AppBg}">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:WelcomeViewModel"><v:WelcomeView /></DataTemplate>
    <DataTemplate DataType="vm:ConnectViewModel"><v:ConnectView /></DataTemplate>
    <DataTemplate DataType="vm:ChooseViewModel"><v:ChooseView /></DataTemplate>
    <DataTemplate DataType="vm:ApplyViewModel"><v:ApplyView /></DataTemplate>
    <DataTemplate DataType="vm:RestoreViewModel"><v:RestoreView /></DataTemplate>
    <DataTemplate DataType="vm:HealthViewModel"><v:HealthView /></DataTemplate>
    <DataTemplate DataType="vm:InstallViewModel"><v:InstallView /></DataTemplate>
    <DataTemplate DataType="vm:RemoteViewModel"><v:RemoteView /></DataTemplate>
    <DataTemplate DataType="vm:TvInfoViewModel"><v:TvInfoView /></DataTemplate>
    <DataTemplate DataType="vm:PrivacyViewModel"><v:PrivacyView /></DataTemplate>
    <DataTemplate DataType="vm:AppsViewModel"><v:AppsView /></DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="Border.dot">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Background" Value="{DynamicResource StepIdleBg}" />
    </Style>
    <Style Selector="Border.dot TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.dot.active">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="Border.dot.active TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.dot.done">
      <Setter Property="Background" Value="{DynamicResource OkBg}" />
    </Style>
    <Style Selector="Border.dot.done TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource OkFg}" />
    </Style>
    <Style Selector="TextBlock.steptitle">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.steptitle.active">
      <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tool Path">
      <Setter Property="Stroke" Value="{DynamicResource AccentFg}" />
      <Setter Property="StrokeThickness" Value="1.6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
    </Style>
    <Style Selector="Button.tool.current TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="RadioButton.lang">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="252,*">
    <!-- Sidebar -->
    <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
      <DockPanel Margin="22,26,22,20">
        <StackPanel DockPanel.Dock="Top" Spacing="34">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SystemAccentColor}">
              <Path Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="22" Height="22" Stretch="Uniform"
                    Data="M3 5 H21 V16 H3 Z M8 20 H16 M12 16 V20 M9 9.5 L11 11.5 L15 7.5" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="UnbloatMyTV" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Text="Android TV · Google TV · Fire TV" Classes="faint" FontSize="11" />
            </StackPanel>
          </StackPanel>

          <Panel>
            <!-- The line joining the step dots -->
            <Border Width="2" HorizontalAlignment="Left" Margin="12,14,0,14" Background="{DynamicResource StepIdleBg}" />
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="18" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:StepInfo">
                  <Button Classes="nav" IsHitTestVisible="{Binding CanNavigate}"
                          Command="{Binding $parent[Window].DataContext.GoToStepCommand}" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Border Classes="dot" Classes.active="{Binding IsActive}" Classes.done="{Binding IsDone}">
                        <Panel>
                          <TextBlock Text="{Binding Number}" IsVisible="{Binding !IsDone}" />
                          <TextBlock Text="✓" IsVisible="{Binding IsDone}" />
                        </Panel>
                      </Border>
                      <TextBlock Classes="steptitle" Classes.active="{Binding IsActive}" Text="{Binding Title}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="16" VerticalAlignment="Bottom">
          <Border Classes="note" IsVisible="{Binding HasDevice}" Padding="12,10">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="{l:T Side_Connected}" />
              <TextBlock Text="{Binding DeviceName}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DeviceAddress}" Classes="faint" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="10" IsVisible="{Binding HasDevice}">
            <Button Classes="link tool" Classes.current="{Binding OnInfo}" Command="{Binding GoInfoCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Path Data="M12 3 A9 9 0 1 1 11.99 3 Z M12 11 V16.5 M12 7.5 V7.6" />
                <TextBlock Text="{l:T Side_Info}" />
              </StackPanel>
            </Button>
            <Button Classes="link tool" Classes.current="{Binding OnHealth}" Command="{Binding GoHealthCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Path Data="M3 12 H7 L10 5 L14 19 L17 12 H21" />
                <TextBlock Text="{l:T Side_Health}" />
              </StackPanel>
            </Button>
            <Button Classes="link tool" Classes.current="{Binding OnPrivacy}" Command="{Binding GoPrivacyCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Path Data="M12 3 L19 6 V11 C19 15.5 16 19 12 21 C8 19 5 15.5 5 11 V6 Z" />
                <TextBlock Text="{l:T Side_Privacy}" />
              </StackPanel>
            </Button>
            <Button Classes="link tool" Classes.current="{Binding OnApps}" Command="{Binding GoAppsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Path Data="M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z" />
                <TextBlock Text="{l:T Side_Apps}" />
              </StackPanel>
            </Button>
            <Button Classes="link tool" Classes.current="{Binding OnRemote}" Command="{Binding GoRemoteCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Path Data="M3 5 H21 V16 H3 Z M8 20 H16 M12 16 V20" />
                <TextBlock Text="{l:T Side_Remote}" />
              </StackPanel>
            </Button>
            <Button Classes="link tool" Classes.current="{Binding OnInstall}" Command="{Binding GoInstallCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Path Data="M12 4 V15 M7 10 L12 15 L17 10 M5 20 H19" />
                <TextBlock Text="{l:T Side_Install}" />
              </StackPanel>
            </Button>
            <Button Classes="link tool" Classes.current="{Binding OnRestore}" Command="{Binding GoRestoreCommand}">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Path Data="M4 12 A8 8 0 1 0 6.5 6.2 M4 4 V8 H8" />
                <TextBlock Text="{l:T Side_Restore}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <Border Height="1" Background="{DynamicResource Divider}" />

          <DockPanel>
            <TextBlock Classes="label" Text="{l:T Side_Language}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
              <RadioButton Classes="lang" GroupName="lang" Content="EN"
                           Theme="{StaticResource {x:Type ToggleButton}}"
                           IsChecked="{Binding Loc.IsEnglish, Mode=TwoWay}" />
              <RadioButton Classes="lang" GroupName="lang" Content="FR"
                           Theme="{StaticResource {x:Type ToggleButton}}"
                           IsChecked="{Binding Loc.IsFrench, Mode=TwoWay}" />
            </StackPanel>
          </DockPanel>
          <DockPanel>
            <TextBlock Classes="faint" Text="{Binding Version}" VerticalAlignment="Center" />
            <Button Classes="link" HorizontalAlignment="Right" FontSize="12"
                    Command="{Binding Updater.CheckNowCommand}" IsEnabled="{Binding !Updater.IsChecking}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"
                         IsVisible="{Binding Updater.HasUpdate}" />
                <TextBlock Text="{Binding Updater.SidebarText}" Foreground="{DynamicResource AccentFg}" FontSize="12" />
              </StackPanel>
            </Button>
          </DockPanel>
        </StackPanel>
        <Panel />
      </DockPanel>
    </Border>

    <!-- Current page -->
    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />

    <!-- Update dialog, over everything -->
    <v:UpdatePanel Grid.ColumnSpan="2" DataContext="{Binding Updater}" IsVisible="{Binding IsOpen}" />
  </Grid>
</Window>
