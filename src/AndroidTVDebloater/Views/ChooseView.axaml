<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:AndroidTVDebloater.Localization"
             xmlns:m="using:AndroidTVDebloater.Models"
             x:Class="AndroidTVDebloater.Views.ChooseView">
  <UserControl.Styles>
    <Style Selector="CheckBox.tweak">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer>
      <StackPanel Margin="44,34,44,32" MaxWidth="900" HorizontalAlignment="Left" Spacing="22">

        <!-- The TV -->
        <Border Classes="card" Padding="20,16">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="link" VerticalAlignment="Center"
                    Content="{l:T Choose_ChangeTv}" Command="{Binding ChangeTvCommand}" />
            <StackPanel Spacing="4">
              <TextBlock Classes="h2" Text="{Binding Device.DisplayName}" />
              <WrapPanel>
                <TextBlock Classes="muted" Text="{Binding AndroidText}" />
                <TextBlock Classes="faint" Text="  ·  " VerticalAlignment="Center" />
                <TextBlock Classes="muted" Text="{Binding RamText}" />
                <TextBlock Classes="faint" Text="  ·  " VerticalAlignment="Center" IsVisible="{Binding HasStorage}" />
                <TextBlock Classes="muted" Text="{Binding StorageText}" IsVisible="{Binding HasStorage}" />
                <TextBlock Classes="faint" Text="  ·  " VerticalAlignment="Center" />
                <TextBlock Classes="muted" Text="{Binding NetworkText}" />
                <TextBlock Classes="faint" Text="  ·  " VerticalAlignment="Center" IsVisible="{Binding HasAlreadyOff}" />
                <TextBlock Classes="muted" Text="{Binding AlreadyOffText}" IsVisible="{Binding HasAlreadyOff}" />
              </WrapPanel>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Fire TV: Amazon's apps can't be turned off; its tracking is in the TV's menu -->
        <Border Classes="card" BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="1.5" IsVisible="{Binding IsFireTv}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
              <Path Stroke="{DynamicResource AccentFg}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="20" Height="20" Stretch="Uniform"
                    Data="M12 3 L19 6 V11 C19 15.5 16 19 12 21 C8 19 5 15.5 5 11 V6 Z M12 8 V12 M12 15.5 V16" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Classes="h2" Text="{l:T Fire_Title}" />
              <TextBlock Classes="muted" Text="{l:T Fire_Text}" />
              <TextBlock Text="{Binding FirePrivacyText}" TextWrapping="Wrap" FontWeight="SemiBold"
                         IsVisible="{Binding !FirePrivacyAllOff}" Foreground="{DynamicResource WarnFg}" />
              <TextBlock Text="{Binding FirePrivacyText}" TextWrapping="Wrap"
                         IsVisible="{Binding FirePrivacyAllOff}" Foreground="{DynamicResource OkFg}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{l:T Fire_Open}" Command="{Binding OpenFirePrivacyCommand}" IsVisible="{Binding !FirePrivacyAllOff}" />
                <Button Content="{l:T Home_CheckAgain}" Command="{Binding CheckFirePrivacyCommand}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Things an update turned back on -->
        <Border Classes="card" BorderBrush="{DynamicResource WarnFg}" BorderThickness="1.5" IsVisible="{Binding HasReturned}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource WarnBg}" VerticalAlignment="Top">
              <Path Stroke="{DynamicResource WarnFg}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="20" Height="20" Stretch="Uniform"
                    Data="M4 12 A8 8 0 1 0 6.5 6.2 M4 4 V8 H8 M12 8 V12 L15 14" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock Classes="h2" Text="{l:T Choose_ReturnedTitle}" />
              <TextBlock Classes="muted" Text="{Binding ReturnedText}" />
              <ItemsControl ItemsSource="{Binding ReturnedNames}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="x:String">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="{l:T Choose_LastNo}" Command="{Binding DismissReturnedCommand}" />
              <Button Classes="accent" Content="{l:T Choose_ReturnedTick}" Command="{Binding TickReturnedCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Same choices as last time, e.g. on the other TV -->
        <Border Classes="card" BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="1.5" IsVisible="{Binding HasLastChoices}">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
              <Path Stroke="{DynamicResource AccentFg}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="20" Height="20" Stretch="Uniform"
                    Data="M8 4 H18 A2 2 0 0 1 20 6 V16 M4 8 H14 A2 2 0 0 1 16 10 V20 H6 A2 2 0 0 1 4 18 Z M7 14 L9 16 L13 12" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock Classes="h2" Text="{l:T Choose_LastTitle}" />
              <TextBlock Classes="muted" Text="{Binding LastChoicesText}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="{l:T Choose_LastNo}" Command="{Binding DismissLastChoicesCommand}" />
              <Button Classes="accent" Content="{l:T Choose_LastUse}" Command="{Binding UseLastChoicesCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Spacing="8">
          <TextBlock Classes="h1" Text="{l:T Choose_Title}" />
          <TextBlock Classes="lead" Text="{l:T Choose_Lead}" />
          <WrapPanel Margin="0,6,0,0">
            <Button Content="{l:T Choose_Recommended}" Command="{Binding SelectRecommendedCommand}" Margin="0,0,10,8" />
            <Button Content="{l:T Choose_None}" Command="{Binding SelectNoneCommand}" Margin="0,0,24,8" />
            <Button Content="{l:T Choose_SaveChoices}" Command="{Binding SaveChoicesCommand}" Margin="0,0,10,8" />
            <Button Content="{l:T Choose_LoadChoices}" Command="{Binding LoadChoicesCommand}" Margin="0,0,10,8" />
          </WrapPanel>
          <Border Classes="note" IsVisible="{Binding ChoicesStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Classes="muted" Text="{Binding ChoicesStatus}" Foreground="{DynamicResource TextMain}" />
          </Border>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="26" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="m:TweakGroup">
              <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Classes="pill count" VerticalAlignment="Bottom">
                      <TextBlock Text="{Binding CountText}" />
                    </Border>
                    <TextBlock Classes="h2" Text="{Binding Title}" />
                  </DockPanel>
                  <TextBlock Classes="muted" Text="{Binding Description}" />
                </StackPanel>
                <Border Classes="card" Padding="0">
                  <ItemsControl Classes="rows" ItemsSource="{Binding Tweaks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="m:Tweak">
                        <Border Classes="row">
                          <StackPanel Spacing="8">
                            <CheckBox Classes="tweak" IsChecked="{Binding IsSelected}">
                              <StackPanel Spacing="3" Margin="4,0,0,0">
                                <WrapPanel>
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,10,0" />
                                  <Border Classes="pill" IsVisible="{Binding Recommended}" Margin="0,0,6,0">
                                    <TextBlock Text="{l:T Choose_RecommendedPill}" />
                                  </Border>
                                  <Border Classes="pill" IsVisible="{Binding IsDone}">
                                    <TextBlock Text="{l:T Choose_DonePill}" />
                                  </Border>
                                </WrapPanel>
                                <TextBlock Classes="muted" Text="{Binding Description}" />
                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasWarning}">
                                  <TextBlock Text="⚠" Foreground="{DynamicResource WarnFg}" />
                                  <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource WarnFg}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Classes="faint mono" Text="{Binding Technical}" Margin="0,2,0,0" />
                              </StackPanel>
                            </CheckBox>
                            <ComboBox Margin="36,0,0,0" MinWidth="320" IsVisible="{Binding HasOptions}"
                                      IsEnabled="{Binding IsSelected}"
                                      ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Help grow the catalog -->
        <Border Classes="card" IsVisible="{Binding HasUnknownApps}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
              <Path Stroke="{DynamicResource AccentFg}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="20" Height="20" Stretch="Uniform"
                    Data="M12 3 A9 9 0 1 1 11.99 3 M9.5 9.5 A2.5 2.5 0 1 1 12 12 V13.5 M12 17 V17.2" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="10">
              <TextBlock Classes="h2" Text="{l:T Choose_UnknownTitle}" />
              <TextBlock Classes="muted" Text="{Binding UnknownText}" />
              <WrapPanel>
                <Button Content="{l:T Choose_UnknownReport}" Command="{Binding ReportUnknownCommand}" Margin="0,0,10,0" />
                <Button Classes="link" Content="{l:T Choose_UnknownCopy}" Command="{Binding CopyUnknownCommand}" VerticalAlignment="Center" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Action bar -->
    <Border Grid.Row="1" Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="44,14">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="accent big" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" />
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedText}" FontWeight="SemiBold" />
          <CheckBox IsChecked="{Binding RebootAfter}" Content="{l:T Choose_Reboot}" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
